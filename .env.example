# Required in production. Use the Django Core Auth origin, without a path.
CONTENT_API_ORIGIN=http://127.0.0.1:8000
# Must match CONTENT_FRONTEND_REVALIDATE_SECRET in Django; use 32+ random characters.
CONTENT_REVALIDATE_SECRET=

# Server-side Core OAuth client for member registration, login and profile APIs.
AUTH_ORIGIN=http://127.0.0.1:8000
PUBLIC_SITE_ORIGIN=http://localhost:3000
PUBLIC_OAUTH_CLIENT_ID=
PUBLIC_OAUTH_CLIENT_SECRET=
PUBLIC_SESSION_SECRET=
